<configuration>
    <property name="ROOT_LOG_LEVEL" value="${ROOT_LOG_LEVEL:-INFO}"/>
    <property name="EXPOSED_LOG_LEVEL" value="${EXPOSED_LOG_LEVEL:-WARN}"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="Exposed" level="${EXPOSED_LOG_LEVEL}"/>
    <logger name="org.jetbrains.exposed" level="${EXPOSED_LOG_LEVEL}"/>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
