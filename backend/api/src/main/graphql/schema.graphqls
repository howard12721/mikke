schema {
  query: Query
  mutation: Mutation
}

"Marks the field, argument, input field or enum value as deprecated"
directive @deprecated(
    "The reason for the deprecation"
    reason: String! = "No longer supported"
  ) on FIELD_DEFINITION | ARGUMENT_DEFINITION | ENUM_VALUE | INPUT_FIELD_DEFINITION

"This directive disables error propagation when a non nullable field returns null for the given operation."
directive @experimental_disableErrorPropagation on QUERY | MUTATION | SUBSCRIPTION

"Directs the executor to include this field or fragment only when the `if` argument is true"
directive @include(
    "Included when true."
    if: Boolean!
  ) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"Indicates an Input Object is a OneOf Input Object."
directive @oneOf on INPUT_OBJECT

"Directs the executor to skip this field or fragment when the `if` argument is true."
directive @skip(
    "Skipped when true."
    if: Boolean!
  ) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"Exposes a URL that specifies the behaviour of this scalar."
directive @specifiedBy(
    "The URL that specifies the behaviour of this scalar."
    url: String!
  ) on SCALAR

type AuthPayload {
  session: AuthSession!
}

type AuthSession {
  accessToken: String!
  accessTokenExpiresAt: String!
  refreshToken: String!
  refreshTokenExpiresAt: String!
}

type BlockRelation {
  blockedUserId: String!
  blockerUserId: String!
  createdAt: String!
}

type BooleanPayload {
  success: Boolean!
}

type ChangePasswordPayload {
  success: Boolean!
}

type CurrentUser {
  avatarMediaId: String
  createdAt: String!
  displayName: String!
  email: String!
  id: String!
  status: String!
  updatedAt: String!
  username: String!
}

type DeletePostPayload {
  success: Boolean!
}

type FriendPage {
  pageInfo: PageInfo!
  users: [User!]!
}

type FriendRequest {
  canceledAt: String
  createdAt: String!
  id: String!
  receiver: User
  respondedAt: String
  sender: User
  status: String!
}

type FriendRequestPage {
  pageInfo: PageInfo!
  requests: [FriendRequest!]!
}

type Friendship {
  createdAt: String!
  id: String!
  removedAt: String
  status: String!
  userHighId: String!
  userLowId: String!
}

type FriendshipSummary {
  canSendRequest: Boolean!
  canViewPosts: Boolean!
  relationStatus: String!
  targetUserId: String!
}

type GeoPoint {
  latitude: Float!
  longitude: Float!
}

type Guess {
  createdAt: String!
  distanceMeters: Float!
  guessedPoint: GeoPoint!
  id: String!
  postAuthorUserId: String!
  postId: String!
  score: Int!
  userId: String!
}

type GuessRankingPage {
  entries: [GuessUserRankingEntry!]!
  pageInfo: PageInfo!
}

type GuessResult {
  correctPoint: GeoPoint!
  distanceMeters: Float!
  guess: Guess!
  score: Int!
}

type GuessUserRankingEntry {
  averageScore: Float!
  bestDistanceMeters: Float!
  guessCount: String!
  rank: String!
  totalScore: String!
  user: User
}

type LogoutPayload {
  success: Boolean!
}

type Media {
  contentLengthBytes: String!
  contentType: String!
  createdAt: String!
  id: String!
  originalUrl: String!
  status: String!
  thumbnailUrl: String!
  uploadedAt: String!
}

type MediaUploadUrl {
  expiresAt: String!
  mediaId: String!
  objectKey: String!
  requiredHeaders: [RequiredHeader!]!
  uploadMethod: String!
  uploadUrl: String!
}

type Mutation {
  acceptFriendRequest(input: FriendRequestIdInput!): Friendship!
  blockUser(input: UserIdInput!): BlockRelation!
  cancelFriendRequest(input: FriendRequestIdInput!): FriendRequest!
  changePassword(input: ChangePasswordInput!): ChangePasswordPayload!
  checkMediaUpload(input: CheckMediaUploadInput!): UploadCheck!
  createMediaUploadUrl(input: CreateMediaUploadInput!): MediaUploadUrl!
  createPost(input: CreatePostInput!): Post!
  deletePost(postId: String!): DeletePostPayload!
  login(input: LoginInput!): AuthPayload!
  logout(input: LogoutInput!): LogoutPayload!
  refresh(input: RefreshInput!): RefreshAuthPayload!
  register(input: RegisterInput!): AuthPayload!
  rejectFriendRequest(input: FriendRequestIdInput!): FriendRequest!
  removeFriend(input: UserIdInput!): BooleanPayload!
  sendFriendRequest(input: SendFriendRequestInput!): FriendRequest!
  submitGuess(input: SubmitGuessInput!): GuessResult!
  unblockUser(input: UserIdInput!): BooleanPayload!
  updatePostCaption(input: UpdatePostCaptionInput!): Post!
  updatePostVisibility(input: UpdatePostVisibilityInput!): Post!
  updateProfile(input: UpdateProfileInput!): CurrentUser!
}

type PageInfo {
  hasNextPage: Boolean!
  nextPageToken: String!
}

type Post {
  authorUserId: String!
  caption: String!
  createdAt: String!
  id: String!
  mediaId: String!
  status: String!
  updatedAt: String!
  visibility: String!
}

type PostGuessStats {
  averageDistanceMeters: Float!
  averageScore: Float!
  bestDistanceMeters: Float!
  guessCount: String!
  postId: String!
}

type PostRankingPage {
  entries: [PostUserRankingEntry!]!
  pageInfo: PageInfo!
}

type PostUserRankingEntry {
  postCount: String!
  rank: String!
  user: User
}

type Query {
  friends(page: PageInput, targetUserId: String!): FriendPage!
  friendship(targetUserId: String!): FriendshipSummary!
  guessRankings(metric: GuessRankingMetric!, page: PageInput): GuessRankingPage!
  health: String!
  incomingFriendRequests(page: PageInput): FriendRequestPage!
  me: CurrentUser!
  myGuessForPost(postId: String!): GuessResult
  myPosts(page: PageInput): TimelinePage!
  outgoingFriendRequests(page: PageInput): FriendRequestPage!
  post(id: String!): TimelineItem!
  postGuessStats(postId: String!): PostGuessStats!
  postRankings(page: PageInput): PostRankingPage!
  searchUsers(page: PageInput, query: String!): UserSearchPayload!
  timeline(page: PageInput): TimelinePage!
  user(id: String!): User!
  userScoreSummary(userId: String!): UserScoreSummary!
}

type RefreshAuthPayload {
  session: AuthSession!
}

type RequiredHeader {
  name: String!
  value: String!
}

type TimelineItem {
  author: User
  media: Media
  myGuessResult: GuessResult
  post: Post!
}

type TimelinePage {
  items: [TimelineItem!]!
  pageInfo: PageInfo!
}

type UploadCheck {
  contentLengthBytes: String!
  contentType: String!
  etag: String!
  mediaId: String!
  objectKey: String!
  status: String!
}

type User {
  avatarMediaId: String
  displayName: String!
  id: String!
  status: String!
  username: String!
}

type UserScoreSummary {
  averageScore: Float!
  bestDistanceMeters: Float!
  guessCount: String!
  totalScore: String!
  userId: String!
}

type UserSearchPayload {
  pageInfo: PageInfo!
  users: [User!]!
}

enum GuessRankingMetric {
  AVERAGE_SCORE
  GUESS_COUNT
  TOTAL_SCORE
}

enum PostVisibility {
  FRIENDS
  PRIVATE
}

input ChangePasswordInput {
  currentPassword: String!
  newPassword: String!
}

input CheckMediaUploadInput {
  mediaId: String!
  objectKey: String!
}

input CreateMediaUploadInput {
  contentLengthBytes: Int!
  contentType: String!
  originalFileName: String
}

input CreatePostInput {
  accuracyMeters: Float!
  caption: String
  location: GeoPointInput!
  mediaId: String!
  visibility: PostVisibility!
}

input FriendRequestIdInput {
  friendRequestId: String!
}

input GeoPointInput {
  latitude: Float!
  longitude: Float!
}

input LoginInput {
  loginId: String!
  password: String!
}

input LogoutInput {
  refreshToken: String!
}

input PageInput {
  pageSize: Int
  pageToken: String
}

input RefreshInput {
  refreshToken: String!
}

input RegisterInput {
  displayName: String!
  email: String!
  password: String!
  username: String!
}

input SendFriendRequestInput {
  receiverUserId: String!
}

input SubmitGuessInput {
  guessedPoint: GeoPointInput!
  postId: String!
}

input UpdatePostCaptionInput {
  caption: String!
  postId: String!
}

input UpdatePostVisibilityInput {
  postId: String!
  visibility: PostVisibility!
}

input UpdateProfileInput {
  avatarMediaId: String
  displayName: String
  username: String
}

input UserIdInput {
  userId: String!
}

